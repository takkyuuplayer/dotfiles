#!/usr/bin/env bash
# Reject pushes to master/main, and pushes that contain WIP commits.
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.

while read -r local_ref local_sha remote_ref remote_sha; do
	case "${remote_ref##refs/heads/}" in
	master | main)
		echo "Do not push to master/main branch!!!"
		exit 1
		;;
	esac

	# An all-zero OID means the ref is being deleted, so there is nothing to
	# inspect. Matching on zeros rather than a literal keeps this working for
	# SHA-256 repositories, where the OID is 64 characters instead of 40.
	[[ $local_sha =~ ^0+$ ]] && continue

	if [[ $remote_sha =~ ^0+$ ]]; then
		range=$local_sha # new branch: examine every commit
	else
		range=$remote_sha..$local_sha
	fi

	if [ -n "$(git rev-list -n 1 --grep '^WIP' "$range")" ]; then
		echo >&2 "Found WIP commit in $local_ref, not pushing"
		exit 1
	fi
done

exit 0
