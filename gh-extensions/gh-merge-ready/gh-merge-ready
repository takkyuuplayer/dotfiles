#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOS'
Usage: gh merge-ready [options]

Squash-merge every open, non-draft PR whose checks have all passed. PRs with
failing or pending checks are skipped. PRs with no checks are merged once their
head commit is older than 10 minutes. Only Dependabot PRs in the authenticated
user's repositories are considered unless told otherwise.

Options:
  -o, --owner <owner>      Repository owner to search (default: authenticated user)
  -R, --repo <owner/repo>  Limit to this repository; repeatable, not with --owner
  -a, --author <login>     Filter by author, "app/<name>" for a GitHub App
                           (default: app/dependabot; '' for any author)
  -n, --dry-run            List the PRs that would be merged, without merging
  -h, --help               Show this help
EOS
}

die() {
  echo "$1" >&2
  exit 1
}

owner=""
repos=()
author="app/dependabot"
dry_run=false

while [ $# -gt 0 ]; do
  case "$1" in
    -o | --owner)
      [ $# -ge 2 ] && [ -n "$2" ] || die "missing value for $1"
      owner=$2
      shift 2
      ;;
    -R | --repo)
      [ $# -ge 2 ] && [ -n "$2" ] || die "missing value for $1"
      repos+=("$2")
      shift 2
      ;;
    -a | --author)
      # An empty value is legal here: it drops the author filter entirely.
      [ $# -ge 2 ] || die "missing value for $1"
      author=$2
      shift 2
      ;;
    -n | --dry-run)
      dry_run=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "unknown option: $1"
      ;;
  esac
done

search="is:pr is:open archived:false draft:false"
[ -z "$author" ] || search+=" author:$author"

if [ ${#repos[@]} -gt 0 ]; then
  [ -z "$owner" ] || die "--repo and --owner are mutually exclusive"
  for repo in "${repos[@]}"; do
    search+=" repo:$repo"
  done
else
  [ -n "$owner" ] || owner=$(gh api user --jq '.login')
  search+=" user:$owner"
fi

# Read each PR's head commit together with its checks in one search: if the
# branch is pushed to afterwards, --match-head-commit aborts the merge instead
# of merging an unverified commit.
# A PR with no checks must wait a while, because CI may not have registered its
# checks yet right after a push.
# gh pr checks is not used: it exits 1 for both failing and no checks.
prs=$(gh api graphql --paginate -F search="$search" -f query='
  query($search: String!, $endCursor: String) {
    search(query: $search, type: ISSUE, first: 100, after: $endCursor) {
      pageInfo { hasNextPage endCursor }
      nodes {
        ... on PullRequest {
          url
          commits(last: 1) {
            nodes { commit { oid committedDate statusCheckRollup { state } } }
          }
        }
      }
    }
  }' --jq '
  .data.search.nodes[]
  | .url + " " + (.commits.nodes[0].commit
    | .oid + " " + (
      if .statusCheckRollup.state == "SUCCESS" then "ready"
      elif .statusCheckRollup != null then "checks not passing"
      elif (.committedDate | fromdateiso8601) < now - 600 then "ready"
      else "no checks yet"
      end))')

status=0

# Fed by a here-string rather than a pipe so failures below set $status in this
# shell instead of in a subshell.
while read -r pr sha reason; do
  [ -n "$pr" ] || continue

  if [ "$reason" != ready ]; then
    echo "skip ($reason): $pr" >&2
    continue
  fi

  if [ "$dry_run" = true ]; then
    echo "dry-run: would merge $pr ($sha)"
    continue
  fi

  gh pr merge "$pr" --squash --match-head-commit "$sha" || {
    echo "failed to merge: $pr" >&2
    status=1
  }
done <<<"$prs"

exit "$status"
