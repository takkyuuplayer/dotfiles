export DOCKER_BUILDKIT=1
export EDITOR="nvim"
export PAGER=less
export LESS="-FgiJKMRW -z-4 --incsearch --mouse --use-color -DSky -DPkw"
export LESSHISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/less/history"
[[ -d "${LESSHISTFILE:h}" ]] || mkdir -p "${LESSHISTFILE:h}" 2>/dev/null

# man の太字/下線は overstrike なので less 側で着色する (旧 LESS_TERMCAP_* の代替)
export MANPAGER="less -Dd+r -Du+g"

export LANGUAGE=en_US.UTF-8
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
